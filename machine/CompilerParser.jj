options {
    STATIC = false;
}

PARSER_BEGIN(CompilerParser)

package machine;


import java.util.List;
import java.util.Map;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.Collections;


public class CompilerParser {

    private boolean preflight = false;
    private boolean inMacroDefinition = false;

    private List<Number> byteCode = new ArrayList<>();
    private CodeSegment codeSegment = new CodeSegment();
    private DataSegment dataSegment = new DataSegment();
    private Map<Integer, Integer> instructionSourceLines = Collections.emptyMap();
    private int codeStart = -1;

    private List<String> macroVariables = new ArrayList<>();
    private final List<Token> deferredGlobalReferences = new ArrayList<>();

    /** Absolute opcode addresses mapped to one-based lines of the parsed source. */
    public Map<Integer, Integer> getInstructionSourceLines() {
        return instructionSourceLines;
    }

    /** First code address, or -1 until a program has parsed successfully. */
    public int getCodeStart() {
        return codeStart;
    }

    public static void main(String[] args) throws ParseException {
        CompilerParser parser = new CompilerParser(System.in);
        parser.Program(false);
    }

    String getImage( Token t ) {
        StringBuilder sb = new StringBuilder();
        for( Token tt = t; tt != null; tt = tt.next ) {
            sb.append(tt.image);
        }
        return sb.toString();
    }

    private Number resolveVariable(Token id, int offset) throws ParseException {
        Number variable = dataSegment.getVariable(id.image, offset);
        if( variable != null ) {
            return variable;
        }
        if( macroVariables.contains(id.image) ) {
            return new Number(0);
        }
        if( preflight && inMacroDefinition ) {
            // Globals follow the macro definitions; retain the token for diagnostics.
            deferredGlobalReferences.add(id);
            return new Number(0);
        }
        throw new ParseException("Unknown variable " + id.image + " in line " + id.beginLine);
    }

    private void validateDeferredGlobalReferences() throws ParseException {
        for( Token id : deferredGlobalReferences ) {
            if( dataSegment.getVariable(id.image) == null ) {
                throw new ParseException("Unknown variable " + id.image + " in line " + id.beginLine);
            }
        }
        deferredGlobalReferences.clear();
    }

    // Returns an address whose value is nonzero when the requested comparison holds.
    private Number emitComparison(Number address, int value, boolean trueWhenEqual) {
        if( value == 0 && !trueWhenEqual ) {
            return address;
        }

        Number flag = dataSegment.newVariable(0);
        codeSegment.addClear(flag);
        if( value == 0 ) {
            Number end = codeSegment.newLabel();
            codeSegment.addJNZ(address, end);
            codeSegment.addINC(flag);
            codeSegment.placeLabel(end);
            return flag;
        }

        // Private cells are restored to these initial values after every evaluation.
        Number remaining = dataSegment.newVariable(value);
        Number consumed = dataSegment.newVariable(0);
        Number loop = codeSegment.newLabel();
        Number checkRemaining = codeSegment.newLabel();
        Number consume = codeSegment.newLabel();
        Number different = codeSegment.newLabel();
        Number restore = codeSegment.newLabel();
        Number restoreLoop = codeSegment.newLabel();
        Number end = codeSegment.newLabel();

        codeSegment.addJNZ(address, checkRemaining);
        codeSegment.addJNZ(remaining, different);
        // Both residual values are zero, so the operands are equal.
        if( trueWhenEqual ) {
            codeSegment.addINC(flag);
        }
        codeSegment.addJNZ(new Number(0), restore);

        codeSegment.placeLabel(checkRemaining);
        codeSegment.addJNZ(remaining, consume);
        codeSegment.placeLabel(different);
        if( !trueWhenEqual ) {
            codeSegment.addINC(flag);
        }
        codeSegment.addJNZ(new Number(0), restore);

        codeSegment.placeLabel(consume);
        codeSegment.addDEC(address);
        codeSegment.addDEC(remaining);
        codeSegment.addINC(consumed);
        codeSegment.addJNZ(new Number(0), loop);

        // Restore both operands before the caller branches on the result.
        codeSegment.placeLabel(restore);
        codeSegment.addJNZ(consumed, restoreLoop);
        codeSegment.addJNZ(new Number(0), end);
        codeSegment.placeLabel(restoreLoop);
        codeSegment.addINC(address);
        codeSegment.addINC(remaining);
        codeSegment.addDEC(consumed);
        codeSegment.addJNZ(consumed, restoreLoop);
        codeSegment.placeLabel(end);
        return flag;
    }

}

PARSER_END(CompilerParser)

SKIP :
{
  " "
| "\t"
| "\r"
| "\n"
}


TOKEN : {
    < HALT : "HALT" >
  | < NOP : "NOP" >
  | < INC : "INC" >
  | < DEC : "DEC" >
  | < JNZ : "JNZ" >
  | < VAR : "var" >
  | < ASSIGN : "=" >
  | < DO : "do" >
  | < WHILE : "while" >
  | < IF : "if" >
  | < ELSE : "else" >
  | < VOID : "void" >
  | < IDENTIFIER : ["a"-"z","A"-"Z","_"] ( ["a"-"z","A"-"Z","_","0"-"9"] )* >
  | < NUMBER : ( ["0"-"9"] )+ >
  | < NEQ : "!=" >
  | < EQ : "==" >
  | < COLON : ":" >
  | < EOS : ";" >
  | < BEGIN : "begin:" >
}

List<Number> Program( boolean preflight ) : {
} {
    {
        this.preflight = preflight;
        dataSegment.add(codeSegment.newLabel("begin"));
    }
    ( MacroDefinition() )*
    ( GlobalVariableDeclaration() <EOS> )*
    {
        if( preflight ) {
            validateDeferredGlobalReferences();
        }
    }
    <BEGIN> {
        codeSegment.placeLabel("begin");
    }
    Statements()
    <EOF> {
        if( !preflight ) {
            codeSegment.validateLabels();
        }
        byteCode.addAll(dataSegment);
        codeSegment.applyOffset( byteCode.size() );
        byteCode.addAll(codeSegment);
        codeStart = dataSegment.size();
        instructionSourceLines = codeSegment.getInstructionSourceLines(codeStart);
        return byteCode;
    }
}

void MacroDefinition() : {
}{
    <VOID> {
        inMacroDefinition = true;
    }
    try {
        MacroSignature() Block()
    } finally {
        inMacroDefinition = false;
        macroVariables.clear();
    }
}

void GlobalVariableDeclaration() : {
    Token id, rvalue, size, index;
    int length = 1;
    int offset = 0;
} {
    <VAR> id = <IDENTIFIER> ( "[" size = <NUMBER> "]" { length = Integer.parseInt(size.image); } )? <ASSIGN> (
          rvalue = <NUMBER> {
            Number variable = dataSegment.newVariable(id.image, length, rvalue.image);
        }
        | rvalue = <IDENTIFIER> ( "[" index = <NUMBER> "]" { offset = Integer.parseInt(index.image); } )? {
            Number right  = dataSegment.getVariable(rvalue.image, offset);
            if( right == null ) {
                throw new ParseException("Unknown variable " + rvalue.image + " in line " + rvalue.beginLine );
            }
            int sourceAddress = right.getValue();
            if( sourceAddress < 0 || sourceAddress >= dataSegment.size() ) {
                throw new ParseException("Invalid initializer reference " + rvalue.image + "[" + offset + "] in line " + rvalue.beginLine);
            }
            int initialValue = dataSegment.get(sourceAddress).getValue();
            Number variable = dataSegment.newVariable(id.image, length, initialValue);
        }
    )
}


void Statements() : {
} {
    ( Statement() )*
}

void Statement() : {
    int previousLine;
} {
    // Labels and macro calls both start with an identifier.
    ( LOOKAHEAD(2) LabelDeclaration() )*
    {
        // The statement after its labels owns the emitted instructions.
        previousLine = codeSegment.getSourceLine();
        codeSegment.setSourceLine(getToken(1).beginLine);
    }
    try {
        ( Block()
        | DoWhileBlock()
        | WhileBlock()
        | IfElseBlock()
        | SimpleStatement() )
    } finally {
        codeSegment.setSourceLine(previousLine);
    }
}

void LabelDeclaration() : {
    Token label;
} {
    label = <IDENTIFIER> <COLON> {
        codeSegment.placeLabel(label.image);
    }
}

void Block() : {
} {
    "{" Statements() "}"
}

void DoWhileBlock() : {
    Number condition;
    Number target = codeSegment.newLabel();
    Token whileToken;
} {
    <DO> Block() whileToken = <WHILE> {
        codeSegment.setSourceLine(whileToken.beginLine);
    } "(" condition = Condition(true) ")" <EOS> {
        codeSegment.addJNZ(condition, target);
    }
}

void WhileBlock() : {
    Number condition;
    Number begin = codeSegment.newLabel();
    Number end = codeSegment.newLabel();
} {
    <WHILE> "(" condition = Condition(false) ")" {
        codeSegment.addJNZ(condition, end);
    } Block() {
        codeSegment.addJNZ(new Number(0), begin);
        codeSegment.placeLabel(end);
    }
}

void IfElseBlock() : {
    Number condition;
    Number elseLabel = codeSegment.newLabel();
    Number endLabel = codeSegment.newLabel();
    boolean hasElse = false;
} {
    <IF> "(" condition = Condition(false) ")" {
        codeSegment.addJNZ(condition, elseLabel);
    } Block() ( <ELSE> {
        codeSegment.addJNZ(new Number(0), endLabel);
        codeSegment.placeLabel(elseLabel);
        hasElse = true;
    } Block() )? {
        codeSegment.placeLabel(endLabel);
    }
    {
        if( !hasElse ) {
            codeSegment.placeLabel(elseLabel);
        }
    }

}

void SimpleStatement() : {
} {
      ( LocalVariableDeclaration() | Command() | Macro() )? <EOS>
}

void MacroSignature() : {
    Token name;
}{
    name = <IDENTIFIER> "(" (
        MacroParameter() ( "," MacroParameter() )*
    )? ")" {
        if( !preflight ) {
            throw new ParseException( "Macro substitution failed!\n" + getImage(name));
        }
    }
}

void MacroParameter() : {
    Token id;
} {
      <NUMBER>
    | id = <IDENTIFIER> { macroVariables.add(id.image); }
}

void Macro() : {
    Token name;
}{
    name = <IDENTIFIER> "(" (
        MacroArgument() ( "," MacroArgument() )*
    )? ")" {
        if( !preflight ) {
            throw new ParseException( "Macro substitution failed!\n" + getImage(name));
        }
    }
}

void MacroArgument() : {
    Token id;
} {
      <NUMBER>
    | id = <IDENTIFIER> {
        // Expansion preserves literal/index text; preflight only resolves the base name.
        resolveVariable(id, 0);
    } ( "[" <NUMBER> "]" )?
}

void LocalVariableDeclaration() : {
    Token id, rvalue, size, index;
    int length = 1;
    int offset = 0;
} {
    <VAR> id = <IDENTIFIER> { macroVariables.add(id.image); } ( "[" size = <NUMBER> "]" { length = Integer.parseInt(size.image); } )? <ASSIGN> (
          rvalue = <NUMBER> {
            if( !preflight ) {
                Number base = dataSegment.newVariable(id.image, length, rvalue.image);
                int value = Integer.parseInt(rvalue.image);
                for( int j = 0; j < length; ++j ) {
                    Number variable = base.offset(j);
                    codeSegment.addClear(variable);
                    for( int i = 0; i < value; ++i ) {
                        codeSegment.addINC(variable);
                    }
                }
            }
        }
        | rvalue = <IDENTIFIER> ( "[" index = <NUMBER> "]" { offset = Integer.parseInt(index.image); } )? {
            if( !preflight ) {
                Number left   = dataSegment.newVariable(id.image, length, 0);
                Number middle = dataSegment.newVariable(0);
                Number right  = dataSegment.getVariable(rvalue.image, offset);
                if( right == null ) {
                    if( !macroVariables.contains(rvalue.image) ) {
                        throw new ParseException("Unknown variable " + rvalue.image + " in line " + rvalue.beginLine );
                    } else {
                        right = new Number(0);
                    }
                }
                for( int j = 0; j < length; ++j ) {
                    codeSegment.addClear(left.offset(j));
                    codeSegment.addClear(middle);
                    codeSegment.addINC(right);
                    Number cloneLoop = codeSegment.newLabel();
                    codeSegment.addINC(left.offset(j));
                    codeSegment.addINC(middle);
                    codeSegment.addDEC(right);
                    codeSegment.addJNZ(right, cloneLoop);
                    codeSegment.addDEC(left.offset(j));
                    Number restoreLoop = codeSegment.newLabel();
                    codeSegment.addINC(right);
                    codeSegment.addDEC(middle);
                    codeSegment.addJNZ(middle, restoreLoop);
                    codeSegment.addDEC(right);
                }
            }
        }
    )
}

void Command() : {
    Number arg1, arg2;
} {

      Halt()
    | Nop()
    | Inc()
    | Dec()
    | Jnz()
}

// if/while branch when the source condition is false; do/while branches when true.
Number Condition(boolean branchOnTrue) : {
    Number address;
    Token operator, number;
} {
    address = Lhs() ( operator = <NEQ> | operator = <EQ> ) number = <NUMBER> {
        boolean trueWhenEqual = (operator.kind == EQ) == branchOnTrue;
        return emitComparison(address, Integer.parseInt(number.image), trueWhenEqual);
    }
}

Number Lhs() : {
    Number address;
    Token literal;
} {
      address = Variable() {
        return address;
      }
    | literal = <NUMBER> {
        return dataSegment.newVariable(Integer.parseInt(literal.image));
      }
}


Number Variable() : {
    Token id, index;
    int offset = 0;
} {
    id = <IDENTIFIER> ( "[" index = <NUMBER> "]" { offset = Integer.parseInt(index.image); } )? {
        return resolveVariable(id, offset);
    }
}

void Halt() : {
} {
    <HALT> { codeSegment.addHALT(); }
}

void Nop() : {
} {
    <NOP> { codeSegment.addNOP(); }
}

void Inc() : {
    Number arg1;
} {
    <INC> arg1 = Variable() { codeSegment.addINC(arg1); }
}

void Dec() : {
    Number arg1;
} {
    <DEC> arg1 = Variable() { codeSegment.addDEC(arg1); }
}

void Jnz() : {
    Number arg1;
    Token arg2;
} {
    <JNZ> arg1 = Variable() arg2 = <IDENTIFIER> {
        Number target = codeSegment.getLabel(arg2.image);
        codeSegment.addJNZ(arg1, target);
    }
}
